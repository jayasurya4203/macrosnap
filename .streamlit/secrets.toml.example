# ==========================================
# MacroSnap Configuration Template
# Copy this file to .streamlit/secrets.toml
# NEVER commit .streamlit/secrets.toml to Git!
# ==========================================

# 1. Google Gemini API Key
# Get a free key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY = "your-gemini-api-key-here"

# 2. Gmail SMTP Credentials (Action Tool: Free & Instant)
# Use your personal or dedicated Gmail address
GMAIL_ADDRESS = "your-email@gmail.com"

# Generate a 16-character App Password:
# Go to: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification turned ON on your Google Account)
# Enter the 16 characters without spaces or with spaces:
GMAIL_APP_PASSWORD = "xxxx xxxx xxxx xxxx"

# Optional: Gemini Model code (defaults to gemini-2.5-flash)
# Options: "gemini-2.5-flash", "gemini-2.0-flash", "gemini-1.5-flash"
GEMINI_MODEL = "gemini-2.5-flash"
